# Copie para frontend/.env.local (não commitar) e preencha com as chaves do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nome em inglês por convenção de env; lido em lib/flags.ts como USAR_MOCKS.
# true = telas usam os mocks (lib/<dominio>/mocks.ts); qualquer outro valor = Supabase real.
NEXT_PUBLIC_USE_MOCKS=true
